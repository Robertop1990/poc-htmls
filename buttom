
import React, { useRef } from 'react';
import { Button } from 'antd';
import { UploadOutlined, FileOutlined } from '@ant-design/icons';
import { useField } from 'formik';

const FormFileUploadCompact = ({
  name,
  onUpload,
  loading = false,
  disabled = false,
}) => {
  const [field, meta, helpers] = useField(name);
  const inputRef = useRef(null);

  const selectedFile = field.value ?? null;

  const handleSelect = (event) => {
    const file = event.target.files?.[0];
    if (!file) return;

    const extension = file.name.split('.').pop()?.toLowerCase();
    const allowed = ['png', 'pdf', 'mp4'];

    if (!allowed.includes(extension)) {
      helpers.setValue(null);
      helpers.setError('Solo se permiten archivos PNG, PDF y MP4.');
      helpers.setTouched(true);
      event.target.value = '';
      return;
    }

    helpers.setValue(file);
    helpers.setError(undefined);
    helpers.setTouched(true);
  };

  const handleUpload = async () => {
    if (!selectedFile || loading || disabled) return;

    await onUpload(selectedFile);

    helpers.setValue(null);
    helpers.setError(undefined);
    helpers.setTouched(false);

    if (inputRef.current) {
      inputRef.current.value = '';
    }
  };

  return (
    <div style={{ padding: '12px 16px' }}>
      <input
        ref={inputRef}
        type="file"
        hidden
        accept=".png,.pdf,.mp4"
        onChange={handleSelect}
      />

      {selectedFile && (
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            gap: 7,
            marginBottom: 12,
            fontSize: 13,
            color: '#333',
            overflowWrap: 'anywhere',
          }}
        >
          <FileOutlined />
          <span>{selectedFile.name}</span>
        </div>
      )}

      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: 10,
          width: '100%',
        }}
      >
        <Button
          disabled={disabled || loading}
          onClick={() => inputRef.current?.click()}
          style={{
            flex: 1,
            minWidth: 0,
            height: 42,
            fontSize: 14,
            borderRadius: 5,
            fontWeight: 500,
          }}
        >
          Examinar...
        </Button>

        <Button
          type="primary"
          icon={<UploadOutlined />}
          loading={loading}
          disabled={!selectedFile || disabled}
          onClick={handleUpload}
          style={{
            width: 46,
            minWidth: 46,
            height: 42,
            padding: 0,
            borderRadius: 5,
            backgroundColor: '#e5a900',
            borderColor: '#e5a900',
            color: '#000',
          }}
        />
      </div>

      <div
        style={{
          marginTop: 12,
          fontSize: 13,
          lineHeight: '20px',
          color: '#777',
        }}
      >
        Formatos permitidos: PNG, PDF y MP4
      </div>

      {meta.touched && meta.error && (
        <div style={{ color: '#dc3545', fontSize: 12, marginTop: 5 }}>
          {meta.error}
        </div>
      )}
    </div>
  );
};

export default FormFileUploadCompact;
