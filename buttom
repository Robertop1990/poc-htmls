
import React, { useRef } from 'react';
import { useField } from 'formik';
import { Button } from 'antd';
import { UploadOutlined, FileOutlined } from '@ant-design/icons';

const FormFileUploadCompact = ({
  name,
  files = [],
  onUpload,
  loading = false,
  disabled = false
}) => {
  const [field, meta, helpers] = useField(name);
  const inputRef = useRef(null);

  const selectedFile = field.value ?? null;

  const handleSelect = (event) => {
    const file = event.target.files?.[0];
    if (!file) return;

    const extension = file.name.split('.').pop().toLowerCase();

    if (!['png', 'pdf', 'mp4'].includes(extension)) {
      helpers.setValue(null);
      helpers.setError('Solo se permiten archivos PNG, PDF y MP4.');
      helpers.setTouched(true, false);
      event.target.value = '';
      return;
    }

    helpers.setValue(file);
    helpers.setError(undefined);
    helpers.setTouched(true, false);
  };

  const handleUpload = async () => {
    if (!selectedFile || loading || disabled) return;

    await onUpload(selectedFile);

    helpers.setValue(null);
    helpers.setError(undefined);
    helpers.setTouched(false, false);

    if (inputRef.current) {
      inputRef.current.value = '';
    }
  };

  return (
    <div
      style={{
        width: '100%',
        height: 400,
        boxSizing: 'border-box',
        border: '1px solid #d9d9d9',
        borderRadius: 4,
        padding: 16,
        display: 'flex',
        flexDirection: 'column',
        backgroundColor: '#fff'
      }}
    >
      {/* Área superior: documentos existentes y archivo seleccionado */}
      <div
        style={{
          flex: 1,
          minHeight: 0,
          overflowY: 'auto',
          padding: '8px 12px'
        }}
      >
        {files.map((file) => (
          <div
            key={file.id}
            style={{
              display: 'flex',
              alignItems: 'flex-start',
              gap: 10,
              marginBottom: 12,
              overflowWrap: 'anywhere'
            }}
          >
            <FileOutlined />
            <a
              href={file.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {file.fileName}
            </a>
          </div>
        ))}

        {selectedFile && (
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 10,
              padding: '10px 8px',
              overflowWrap: 'anywhere'
            }}
          >
            <FileOutlined style={{ fontSize: 18 }} />
            <span>{selectedFile.name}</span>
          </div>
        )}
      </div>

      {/* Controles inferiores: siempre en una sola fila */}
      <input
        ref={inputRef}
        type="file"
        accept=".png,.pdf,.mp4"
        hidden
        onChange={handleSelect}
      />

      <div
        style={{
          display: 'grid',
          gridTemplateColumns: 'minmax(0, 1fr) 64px',
          gap: 12,
          alignItems: 'center'
        }}
      >
        <Button
          disabled={disabled || loading}
          onClick={() => inputRef.current?.click()}
          style={{
            width: '100%',
            height: 56,
            borderRadius: 6,
            fontSize: 16,
            fontWeight: 500
          }}
        >
          Examinar...
        </Button>

        <Button
          type="primary"
          icon={<UploadOutlined />}
          loading={loading}
          disabled={!selectedFile || disabled}
          onClick={handleUpload}
          style={{
            width: 64,
            height: 56,
            borderRadius: 6,
            backgroundColor: '#d6a500',
            borderColor: '#d6a500',
            color: '#000',
            fontSize: 20
          }}
        />
      </div>

      <div
        style={{
          marginTop: 12,
          fontSize: 15,
          lineHeight: 1.6,
          color: '#777'
        }}
      >
        Formatos permitidos: PNG, PDF y MP4
      </div>

      {meta.error && (
        <div style={{ marginTop: 6, color: '#dc3545', fontSize: 12 }}>
          {meta.error}
        </div>
      )}
    </div>
  );
};

export default FormFileUploadCompact;
