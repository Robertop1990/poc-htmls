
import React, { useRef } from 'react';
import { useField } from 'formik';
import { Button } from 'antd';
import {
  UploadOutlined,
  FileOutlined
} from '@ant-design/icons';

const FormFileUploadCompact = ({
  name,
  files = [],
  onUpload,
  loading = false,
  disabled = false
}) => {
  const [field, meta, helpers] = useField(name);
  const inputRef = useRef(null);

  const selectedFile = field.value ?? null;

  const handleSelect = (event) => {
    const file = event.target.files?.[0];

    if (!file) return;

    const allowedExtensions = ['png', 'pdf', 'mp4'];
    const extension = file.name.split('.').pop().toLowerCase();

    if (!allowedExtensions.includes(extension)) {
      helpers.setValue(null);
      helpers.setError('Solo se permiten archivos PNG, PDF y MP4.');
      helpers.setTouched(true, false);
      event.target.value = '';
      return;
    }

    helpers.setValue(file);
    helpers.setError(undefined);
    helpers.setTouched(true, false);
  };

  const handleUpload = async () => {
    if (!selectedFile || loading || disabled) return;

    await onUpload(selectedFile);

    helpers.setValue(null);
    helpers.setError(undefined);
    helpers.setTouched(false, false);

    if (inputRef.current) {
      inputRef.current.value = '';
    }
  };

  return (
    <div
      style={{
        border: '1px solid #d9d9d9',
        borderRadius: 4,
        padding: 16,
        width: '100%',
        boxSizing: 'border-box'
      }}
    >
      {/* Documentos existentes y archivo seleccionado */}
      <div
        style={{
          height: 230,
          overflowY: 'auto',
          display: 'flex',
          flexDirection: 'column',
          marginBottom: 12
        }}
      >
        {files.map((file) => (
          <div
            key={file.id}
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 8,
              marginBottom: 8,
              overflowWrap: 'anywhere'
            }}
          >
            <FileOutlined />
            <a
              href={file.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {file.fileName}
            </a>
          </div>
        ))}

        {selectedFile && (
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 8,
              marginTop: 12,
              padding: '8px 10px',
              backgroundColor: '#f5f5f5',
              borderRadius: 4
            }}
          >
            <FileOutlined />
            <span
              style={{
                flex: 1,
                minWidth: 0,
                overflowWrap: 'anywhere'
              }}
            >
              {selectedFile.name}
            </span>

            <Button
              type="text"
              danger
              size="small"
              disabled={loading}
              onClick={() => {
                helpers.setValue(null);
                helpers.setError(undefined);
                if (inputRef.current) {
                  inputRef.current.value = '';
                }
              }}
            >
              Quitar
            </Button>
          </div>
        )}
      </div>

      {/* Controles inferiores */}
      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: 12,
          flexWrap: 'wrap'
        }}
      >
        <input
          ref={inputRef}
          type="file"
          accept=".png,.pdf,.mp4"
          hidden
          onChange={handleSelect}
        />

        <Button
          disabled={disabled || loading}
          onClick={() => inputRef.current?.click()}
          style={{
            width: 180,
            height: 44,
            flexShrink: 0,
            borderRadius: 6,
            fontSize: 16
          }}
        >
          Examinar...
        </Button>

        <Button
          type="primary"
          icon={<UploadOutlined />}
          loading={loading}
          disabled={!selectedFile || disabled}
          onClick={handleUpload}
          style={{
            width: 52,
            height: 44,
            flexShrink: 0,
            borderRadius: 6,
            backgroundColor: '#d6a500',
            borderColor: '#d6a500',
            color: '#000'
          }}
        />
      </div>

      <div
        style={{
          marginTop: 12,
          fontSize: 15,
          color: '#777'
        }}
      >
        Formatos permitidos: PNG, PDF y MP4
      </div>

      {meta.error && (
        <div
          style={{
            marginTop: 8,
            color: '#dc3545',
            fontSize: 12
          }}
        >
          {meta.error}
        </div>
      )}
    </div>
  );
};

export default FormFileUploadCompact;
